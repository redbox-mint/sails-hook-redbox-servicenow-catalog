meta {
  name: Catalog info requires a researcher
  type: http
  seq: 1
}

get {
  url: {{host}}/default/rdmp/ws/catalog/info
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-Source: jsclient
}

tests {
  test("Status code is 403", function () {
    expect(res.getStatus()).to.equal(403);
  });

  test("Response is access denied", function () {
    expect(res.getBody().message).to.eql("Access Denied");
  });
}
