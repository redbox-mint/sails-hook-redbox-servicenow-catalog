meta {
  name: Parent info requires a researcher
  type: http
  seq: 2
}

post {
  url: {{host}}/default/rdmp/ws/catalog/rdmp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-Source: jsclient
}

body:json {
  {
    "rdmp": "parent-1"
  }
}

tests {
  test("Status code is 403", function () {
    expect(res.getStatus()).to.equal(403);
  });

  test("Response is access denied", function () {
    expect(res.getBody().message).to.eql("Access Denied");
  });
}
